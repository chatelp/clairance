# Clairance configuration. Every key below does something. A key left out takes
# the default written in internal/config/defaults.go; a key this version no longer
# reads is named at startup and ignored, never refused. Values that were measured
# keep their reason in one line; the measurements themselves are in docs-fr/.

[server]
port = 8000                                 # web interface and API
host = "127.0.0.1"                          # 0.0.0.0 to reach it from the network; sign-in is then required
additional_ports = [8001, 8002, 8003, 8004] # the audio streams are spread over these, one per listener
# Reverse proxies whose X-Forwarded-* headers may be believed, as CIDRs: none by default, on purpose.
trusted_proxies = []
# Pages served from elsewhere that may call this server with the session: none by default. The
# server itself, under any name, on any of its ports, needs no entry. A page reached by a name the
# server cannot know (a VPN address, a proxy that rewrites Host) is logged when refused; "*" is refused.
# allowed_origins = []                      # e.g. ["http://100.101.102.103:8000"]
audio_replay = "owner"                      # who listens to the streams and the archived clips: "owner", or "all" (viewers too)
# static_dir = "www"                        # serve the page from this directory instead of the one built into the binary
# tls_cert and tls_key serve HTTPS with no proxy at all; leave them out behind one.
# keep_awake = true                         # macOS: the Mac does not sleep while the server runs (caffeinate)
# instance = "production"                   # this server's name for the launcher (docs-fr/36-contrat-lanceur.md)

[auth]
enabled = false                             # off on purpose: nobody cloning this may be locked out of their own receiver
# When host is not 127.0.0.1 the first visit asks for an account; or co-atc -add-user <name>
# prints a [[auth.users]] block (name, Argon2id password_hash) to paste here. A session lives
# 720 h unused; 8 wrong passwords per address (an IPv6 /64) per 15 min. Restarting ends every session.
# An account is an owner unless it says role = "viewer" (here or in users.json): a viewer reads
# the map, the aircraft and the transcriptions, changes nothing, and is given the audio only
# when [server] audio_replay = "all", two streams of a frequency at most; it is not told the
# streams' addresses nor the server's paths. Every sign-in, refused or not, is traced in signins.jsonl
# beside the accounts (two files of 1 MB at most); the owner reads the last ones at /api/v1/signins.

[station]
latitude = 43.6777                          # the receiver, decimal degrees (example: Toronto Pearson)
longitude = -79.6248
elevation_feet = 569
airport_code = "CYYZ"                       # ICAO; the reference airport, changeable from the settings panel
# airport_range_nm = 5 ("at this airport", also for the flight phases), display_range_nm = 100
# (airports, runways and navaids drawn), runway_extension_length_nm = 10.

[adsb]
# "tar1090" (a local receiver), "readsb-api", "readsb-file", "external-opensky" or "external-rapidapi".
source_type = "external-opensky"
tar1090_base_url = "http://192.168.1.166/tar1090/data/"   # where tar1090 serves aircraft.json, receiver.json, stats.json
# readsb-api needs readsb_api_url; external-rapidapi needs api_key. Fetched every second; an
# aircraft is signal_lost after 60 s. The source is probed at startup.

[frequencies]
# A source is anything ffmpeg reads: Icecast or LiveATC over HTTP, SRT (ffmpeg built with
# libsrt), raw PCM over UDP from an SDR program, a receiver on the sound card. An 8 KB buffer,
# a reconnect after 5 s. LiveATC asks not to redistribute its streams.
# decoder = "go"                            # MP3 over HTTP decoded inside the binary, no ffmpeg (being tested)

[[frequencies.sources]]
id = "cyyz_twr"                             # unique; names the stream in the database and the API
airport = "CYYZ"
name = "CYYZ Tower"
frequency_mhz = 118.700                     # 0 for a mixed stream that has no single frequency
url = "https://s1-bos.liveatc.net/cyyz7"
order = 3                                   # display order
transcribe_audio = true
# From the catalogue, not the model: detection measured wrong on 16% of French, 28% of English.
language = "en"

[[frequencies.sources]]
id = "cyyz_arr"
airport = "CYYZ"
name = "CYYZ Arrivals"
frequency_mhz = 124.475
url = "https://s1-fmt2.liveatc.net/cyyz6"
order = 4
transcribe_audio = false

[[frequencies.sources]]
id = "cyyz_dep"
airport = "CYYZ"
name = "CYYZ Departures"
frequency_mhz = 127.575
url = "https://s1-bos.liveatc.net/cyyz8"
order = 5
transcribe_audio = false

# SRT from RTLSDR-Airband, read by ffmpeg itself (built with libsrt; Homebrew's is).
[[frequencies.sources]]
id = "cyyz_lcl"
airport = "CYYZ"
name = "Local"
frequency_mhz = 133.7
url = "srt://192.168.1.166:42069"
order = 6
transcribe_audio = true

# Raw PCM over UDP, as GQRX, SDR++ or rtl_fm send it: ffmpeg must be told the format first.
#[[frequencies.sources]]
#id = "sdr_udp"
#name = "SDR++ network sink"
#frequency_mhz = 118.7
#url = "udp://127.0.0.1:7355"
#ffmpeg_input_options = ["-f", "s16le", "-ar", "48000", "-ac", "1"]
#order = 7
#transcribe_audio = true

# A receiver on the sound card: the capture device is the input. macOS "-f", "avfoundation"
# with url ":0" (ffmpeg -f avfoundation -list_devices true -i ""); Linux "-f", "alsa" with
# url "hw:1" or "-f", "pulse" with "default"; Windows "-f", "dshow" with "audio=Line In".
#[[frequencies.sources]]
#id = "scanner"
#name = "Scanner line-in"
#frequency_mhz = 118.7
#url = ":0"
#ffmpeg_input_options = ["-f", "avfoundation"]
#order = 8
#transcribe_audio = true

[transcription]
# Local, on this machine: whole transmissions are posted to the sidecar in sidecar/, which
# honours upstream's docs/LOCAL-STT.md; no key, no audio leaves the host. ffmpeg decodes
# each stream to 24 kHz mono s16le. language = "en" serves a source that names none.
log_dir = "data/transcriptions"             # raw/{date}_{frequency}.log, append-only; empty to disable
# Swept at start and every hour, never today's files; 0 keeps everything. The archive of clips
# (--save-audio below, or audio_archive_dir) loses its oldest clips past the size; its manifests stay.
audio_archive_max_gb = 2                    # one to two days on two frequencies
raw_log_max_days = 30                       # raw logs older than this, by the date in their name

# Keep this sub-table last in [transcription]: a key written below it lands in it.
[transcription.local]
command = []                                # empty: a sidecar you run yourself at server_url (default http://127.0.0.1:8178)
# Else the server starts it and stops it on exit; either way it probes /health first (a cold
# sidecar answers in 1.6 s, measured) and refuses to run half deaf. Options worth their cost:
# --second-opinion reads a transmission twice when French words appear (+8.5% true callsigns
# at equal precision, Q29); --fr-detector <multilingual MLX Whisper> opens it on French the
# English model turned into English (+8%, Q50); --save-audio <dir> keeps every transmission
# (1-2 GB a day on two frequencies), which the page then lets you listen to again, line by line.
# Details in sidecar/README.md and docs-fr/05-decisions.md.
# command = ["python3", "sidecar/whisper_server.py", "--preload", "--second-opinion"]
# Linux (faster-whisper, NVIDIA GPU or processor), with CTranslate2 models (sidecar/README.md):
# command = ["python3", "sidecar/whisper_server.py", "--model-en", "models/whisper-large-v3-atco2-asr-ct2", "--preload"]
# audio_archive_dir = ""                    # where those clips are; empty: the --save-audio of command
#
# Cutting the stream into transmissions: 600 ms of silence ends one, under 400 ms is dropped,
# 30 s at most, 200 ms kept before speech, silence_threshold 0.005 -- an SDR feed sits at
# -90 dBFS between transmissions; a noisier source such as LiveATC needs a higher threshold.

[post_processing]
enabled = true                              # the phraseology grammar against live ADS-B: speaker, callsign, clearance; no key
# Measured on 1468 transmissions (docs-fr/19-appariement-en-ligne.md): 3 digits minimum, a
# 60 s fleet window, no score floor -- 138 matches, 69% above chance. Runs every 10 s, 20 at a time.

[storage]
sqlite_base_path = "data"                   # one co-atc-YYYY-MM-DD.db a day
db_retention_gb = 20                        # 8 to 11 full days (1.8 GB a day measured, 2.6 at the busiest); the panel can change it

[logging]
level = "info"                              # debug, info, warn, error; changeable from the settings panel
file = "runs/co-atc.log"                    # empty: stdout. One file a day, 100 MB at most, 7 kept (17 MB a day measured)

[station_link]
# For a radio-ctl station only (docs-fr/36-contrat-lanceur.md): co-atc runs cmd/radio-ctl-sync, which
# follows the channels the station has on the air and reports its state; started again when it dies,
# stopped with co-atc, it signs in with a key co-atc makes at each start, never with a password.
# enabled = true
# station_url = "http://station.lan"        # radio-ctl
# station_host = ""                         # the Host header radio-ctl expects, if any
# streams_url = "http://audio.lan"          # base URL of the station's Icecast mounts
# interval_seconds = 10                     # how often the station is read
# mix_id = ""                               # a mixed stream whose label follows the station
# program = ""                              # empty: radio-ctl-sync next to co-atc (go build -o bin/radio-ctl-sync ./cmd/radio-ctl-sync)

[reference]
# OurAirports and tar1090-db files under assets/ (scripts/download_assets.sh): aircraft.csv,
# airlines.dat (also the grammar's airline telephony), airports.csv, airport-frequencies.csv,
# runways.csv, navaids.csv. Name a key only to put a file elsewhere.

[wx]
# Windy's airport API, every 10 min, cached 60 min. Windy asks not to steal it: METARs are free
# at https://www.aviationweather.gov/dataserver.
fetch_metar = true
fetch_taf = true
fetch_notams = true

[flight_phases]
enabled = true                              # taxi, takeoff, departure, cruise, approach, landing, judged from trajectories
signal_lost_landing_enabled = true          # an aircraft lost below 1000 ft near a runway has landed
# Five values differ from the code's defaults and stay written: the runway judge was validated
# 368/368 against FlightAware with them (docs-fr/32-audit-produit.md).
flying_min_alt_ft = 300                     # flying above this altitude (default 700)
phase_preservation_seconds = 30             # takeoff and landing stay visible this long (default 60)
phase_transition_timeout_seconds = 1800     # a stop on the ground this long before taxi goes back to new (default 60)
runway_in_use_approach_weight = 2.0         # evidence weight of an approach for the runway in use (default 5)
runway_in_use_climb_weight = 2.0            # same for a climb-out (default 1.5)
