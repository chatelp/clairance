# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Build artifacts
/bin/
/dist/

# Log files
*.log

/data/
/temp/

/configs/config.toml
/configs/opensky_credentials.json
config.toml
# Local run logs (Clairance fork)
/runs/

# Python
__pycache__/
*.py[cod]
.venv/

# --- Clairance fork ---------------------------------------------------
# Credentials and certificates. The server can be given a TLS certificate
# (see [server] tls_cert / tls_key); nothing of the sort belongs here.
*.pem
*.key
*.crt
*.p12
.env
.env.*

# Written by the running server next to its config file: log level,
# retention, and anything else changed from the settings panel.
/configs/runtime-settings.json

# Build outputs of the extra commands this fork adds.
/co-atc
/phraseology
/cmd/phraseology/phraseology

# Databases. D13: the daily SQLite files are the only local trace of the
# radio/ADS-B cross-reference and they never go in git.
*.sqlite
*.sqlite-*
*.db

# Captured audio and measurement runs. The 120-transmission evaluation set is
# deliberately kept out of the repository -- see Q16 in docs-fr/05-decisions.md.
/whisper-lab/
/corpus/
*.mp3.json

# Personal editor and agent settings.
.claude/settings.local.json
/.trash/

# Accounts created by the first-run page. Password hashes, never published.
configs/users.json
# The sign-in trace kept beside them: who signed in, from which address.
configs/signins.jsonl*
# The sessions kept across restarts: hashes of the cookies, never the cookies.
configs/sessions.json*

# Aeronautical charts (SIA VAC and eAIP charts), kept next to the code for
# reference. Never published: they are the SIA's, and they expire each cycle.
/charts/

# Airport layout, generated per station from OpenStreetMap (tools/airport-layout/fetch.py)
/www/data/airport-layout.geojson
